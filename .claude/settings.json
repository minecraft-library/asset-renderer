{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/parity-gate-precommit.js\"",
            "timeout": 20,
            "statusMessage": "Checking parity gate..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew parityPlan)",
      "Bash(./gradlew parityExpect -PexpectEmpty)",
      "Bash(./gradlew parityCapture)",
      "Bash(./gradlew parityCapture -Partifacts=manifest.tooling-tables)",
      "Bash(./gradlew parityCapture -Partifacts=manifest.tooling-tables -PparityRoot=cache/parity/base)",
      "Bash(./gradlew parityCompare)",
      "Bash(./gradlew parityCompare -Psummary)",
      "Bash(./gradlew parityCompare -Pbase=cache/parity/base)",
      "Bash(./gradlew paritySelfTest)",
      "Bash(./gradlew slowTest)",
      "Bash(./gradlew menuRender)",
      "Bash(./gradlew entityParityVanilla)"
    ]
  }
}
