{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/parity-gate-precommit.js\"",
            "timeout": 20,
            "statusMessage": "Checking parity gate..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew parityPlan*)",
      "Bash(./gradlew parityExpect*)",
      "Bash(./gradlew parityCapture*)",
      "Bash(./gradlew parityCompare*)",
      "Bash(./gradlew paritySelfTest*)",
      "Bash(./gradlew slowTest*)",
      "Bash(./gradlew menuRender*)",
      "Bash(./gradlew entityParityVanilla*)"
    ]
  }
}
