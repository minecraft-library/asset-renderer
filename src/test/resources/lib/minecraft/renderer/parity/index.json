    },
    "report.failure-rows": {
      "pointer": "sweeps/<sweep>.json#/rows/<n>/status"
    },
    "report.harness-sweep-counts": {
      "pointer": "<artifact>#/provenance/counts"
    },
    "report.run-provenance": {
      "pointer": "<artifact>#/provenance"
    },
    "report.sum": {
      "pointer": "sweeps/<sweep>.json#/summary/sum"
    },
    "report.wall-time": {
      "pointer": "<artifact>#/provenance/wall_time_ms"
    },
    "report.worst-list": {
      "pointer": "sweeps/<sweep>.json#/summary/worst"
    }
  },
  "sources": {
    "pin.armor-span": {
      "cross_repo": false,
      "re_derive": "inspect the built shell's vertical span; the trim-triple assertion beside it is the only coverage of the item-icon half of the trim permutation",
      "test_class": "lib.minecraft.renderer.bake.armor.ArmorKitTest"
    },
    "roster.appearance-axes": {
      "cross_repo": true,
      "re_derive": "AppearanceKey.Axis against the harness TraitAxis; asset is a strict superset",
      "test_class": "lib.minecraft.renderer.sweep.AppearanceKey"
    },
    "roster.armor-subjects": {
      "anchor": [
        "SUBJECTS = List.of("
      ],
      "cross_repo": true,
      "lines": "130-137",
      "re_derive": "must match the harness ArmorSweep roster byte for byte or the sweep finds no reference",
      "test_class": "lib.minecraft.renderer.sweep.ArmorParitySweep"
    },
    "roster.dump-sections": {
      "cross_repo": false,
      "re_derive": "PipelineParityDump's section insertion order; the values are the keys of manifests/dump-*.json, so a drift is already gated",
      "test_class": "lib.minecraft.renderer.dump.PipelineParityDump"
    },
    "roster.face-phase": {
      "cross_repo": false,
      "re_derive": "vanilla's own corner order per face, read off the bakery and the polygon paths",
      "test_class": "lib.minecraft.renderer.engine.geometry.CornerPhaseTest"
    },
    "roster.frame-turn": {
      "cross_repo": false,
      "re_derive": "the order-8 diagonal group; each constant is which axes it negates",
      "test_class": "lib.minecraft.renderer.engine.geometry.AxisSignsTest"
    },
    "roster.glint-subjects": {
      "anchor": [
        "GUI_GLINT_ITEMS = List.of(",
        "LEATHER_ARMOR_ITEMS = List.of("
      ],
      "cross_repo": true,
      "lines": "111-119, 129-134",
      "re_derive": "the 7 always-foil GUI items plus the 4 worn-leather diagnostics the harness GlintSweep renders",
      "test_class": "lib.minecraft.renderer.sweep.GlintParitySweep"
    },
    "roster.humanoid-armor": {
      "anchor": [
        "EXPECTED = Set.of("
      ],
      "cross_repo": false,
      "lines": "29-33",
      "re_derive": "EntityModelLoader.load() filtered on humanoidArmor().isPresent()",
      "test_class": "lib.minecraft.renderer.content.index.EntityModelLoaderArmorRosterTest"
    },
    "roster.humanoid-part-crop": {
      "anchor": [
        "ORIGINS = {"
      ],
      "cross_repo": false,
      "lines": "36-49",
      "re_derive": "Unwrap.Atlas.rect at each part's atlas origin under AxisSigns.HALF_X",
      "test_class": "lib.minecraft.renderer.vanilla.mesh.HumanoidPartCropTest"
    },
    "roster.overlay-pipeline": {
      "cross_repo": false,
      "re_derive": "EntityPipelineTraits over the extracted client jar's layer classes",
      "test_class": "lib.minecraft.renderer.content.index.EntityModelLoaderOverlayPassTest"
    },
    "roster.pack-fixtures": {
      "cross_repo": false,
      "re_derive": "PipelineParityDump's PACK_FIXTURES. A member missing from cache/asset-renderer/packs/ does not throw: the dump skips the packs configuration and writes vanilla/ alone, and a capture of manifest.dump.packs then refuses with no tree to hash. The store keeps no copy of the set; renderVanillaPackSources defaults to the same three names",
      "test_class": "lib.minecraft.renderer.dump.PipelineParityDump"
    },
    "roster.player-scopes": {
      "anchor": [
        "List.of(PlayerOptions.Type.FULL, PlayerOptions.Type.SKULL)"
      ],
      "cross_repo": false,
      "lines": "103",
      "re_derive": "the scopes the harness PlayerSweep renders",
      "test_class": "lib.minecraft.renderer.sweep.PlayerParitySweep"
    },
    "roster.sheet-groups": {
      "cross_repo": false,
      "re_derive": "the -Psheets groups PlayerRenderDriver accepts; ten offline plus the network-only account group",
      "test_class": "lib.minecraft.renderer.driver.PlayerRenderDriver"
    }
  }
}
