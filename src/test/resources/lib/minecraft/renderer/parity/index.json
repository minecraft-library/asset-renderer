    "probe.pack-sources": {
      "home": "cache/asset-renderer/vanilla/<version>/pack-sources/",
      "reason": "written deliberately outside the reference tree by renderVanillaPackSources, and read by packSourceParityVanilla, a diagnostic report rather than a gate",
      "stored": false
    },
    "probe.pixel": {
      "home": "untracked working notes",
      "reason": "instrumented-build evidence; not reproducible by re-running a gate, so it can be neither captured, compared nor promoted, and what it was written into is gitignored rather than tracked, so no path here would resolve for anyone who clones this",
      "stored": false
    },
    "report.expected-diff": {
      "home": "<working root>/_run/expected-diff.json",
      "reason": "a pre-registered input to one gate, written before the capture it gates",
      "stored": false
    },
    "report.harness-fit-log": {
      "home": "build/parity/harness-<task>.log",
      "reason": "the harness prints one fit line per cohort to stdout; the tee under build/ is where it is persisted, and it is scratch rather than a promoted value",
      "stored": false
    },
    "report.movers": {
      "home": "<working root>/_run/compare.json",
      "reason": "a statement about a comparison rather than a value a run produces, so it is never promoted",
      "stored": false
    },
    "report.plan": {
      "home": "<working root>/_run/plan.json",
      "reason": "what a changed path sees and is blind to; capture-only, never promoted",
      "stored": false
    }
