  "external": {
    "digest.dump-sections": {
      "home": "cache/parity-dump/<label>/{vanilla,packs}/",
      "reason": "the same 28 values manifest.dump.vanilla and manifest.dump.packs already carry, one per section file; a third copy of one number",
      "stored": false
    },
    "pin.tick-lattice": {
      "home": "lib.minecraft.renderer.engine.frame.TimelineTest",
      "reason": "an identity (millisAt(f) == tickAt(f) * 50.0), not a captured value - re-baselining is not a concept for it",
      "stored": false
    },
    "probe.depth-quantum": {
      "home": "cache/asset-renderer/vanilla/<version>/depth-quantum-probe/",
      "reason": "written deliberately outside the reference tree by renderVanillaDepthQuantumProbe",
      "stored": false
    },
    "probe.pixel": {
      "home": "untracked working notes",
      "reason": "instrumented-build evidence; not reproducible by re-running a gate, so it can be neither captured, compared nor promoted, and what it was written into is gitignored rather than tracked, so no path here would resolve for anyone who clones this",
      "stored": false
    },
    "report.capture-note": {
      "home": "commit messages",
      "reason": "its one non-duplicated field is the promotion reason, which is a provenance key; its restore recipe is parityCompare, which is code rather than prose",
      "stored": false
    },
    "report.expected-diff": {
      "home": "<working root>/_run/expected-diff.json",
      "reason": "a pre-registered input to one gate, written before the capture it gates",
      "stored": false
    },
    "report.harness-fit-log": {
      "home": "build/parity/harness-<task>.log",
      "reason": "the harness prints one fit line per cohort to stdout; the tee under build/ is where it is persisted, and it is scratch rather than a promoted value",
      "stored": false
    },
    "report.movers": {
      "home": "<working root>/_run/compare.json",
      "reason": "a statement about a comparison rather than a value a run produces, so it is never promoted",
      "stored": false
    },
    "report.plan": {
      "home": "<working root>/_run/plan.json",
      "reason": "what a changed path sees and is blind to; capture-only, never promoted",
      "stored": false
    }
  },
  "format": 1,
  "key": "artifact",
  "kind": "index",
  "pointers": {
    "report.buckets": {
