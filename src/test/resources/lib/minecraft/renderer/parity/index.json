  "sources": {
    "pin.armor-span": {
      "cross_repo": false,
      "re_derive": "inspect the built shell's vertical span; the trim-triple assertion beside it is the only coverage of the item-icon half of the trim permutation",
      "test_class": "lib.minecraft.renderer.engine.kit.ArmorKitCitCompositeTest"
    },
    "roster.appearance-axes": {
      "cross_repo": true,
      "re_derive": "AppearanceKey.Axis against the harness TraitAxis; asset is a strict superset",
      "test_class": "lib.minecraft.renderer.visual.AppearanceKey"
    },
    "roster.armor-subjects": {
      "cross_repo": true,
      "lines": "127-134",
      "re_derive": "must match the harness ArmorSweep roster byte for byte or the sweep finds no reference",
      "test_class": "lib.minecraft.renderer.visual.TestArmorParityVanilla"
    },
    "roster.dump-sections": {
      "cross_repo": false,
      "re_derive": "PipelineParityDump's section insertion order; the values are the keys of manifests/dump-*.json, so a drift is already gated",
      "test_class": "lib.minecraft.renderer.pipeline.dump.PipelineParityDump"
    },
    "roster.face-phase": {
      "cross_repo": false,
      "re_derive": "vanilla's own corner order per face, read off the bakery and the polygon paths",
      "test_class": "lib.minecraft.renderer.face.FacePhaseTest"
    },
    "roster.frame-turn": {
      "cross_repo": false,
      "re_derive": "the order-8 diagonal group; each constant is which axes it negates",
      "test_class": "lib.minecraft.renderer.face.FrameTurnTest"
    },
    "roster.glint-subjects": {
      "cross_repo": true,
      "lines": "106-114, 124-129",
      "re_derive": "the 7 always-foil GUI items plus the 4 worn-leather diagnostics the harness GlintSweep renders",
      "test_class": "lib.minecraft.renderer.visual.TestGlintParityVanilla"
    },
    "roster.humanoid-armor": {
      "cross_repo": false,
      "lines": "30-34",
      "re_derive": "EntityModelLoader.load() filtered on humanoidArmor().isPresent()",
      "test_class": "lib.minecraft.renderer.pipeline.loader.HumanoidArmorRosterTest"
    },
    "roster.humanoid-part-crop": {
      "cross_repo": false,
      "lines": "35-48",
      "re_derive": "Unwrap.Atlas.rect at each part's atlas origin under Turn.HALF_X",
      "test_class": "lib.minecraft.renderer.face.HumanoidPartCropTest"
    },
    "roster.overlay-pipeline": {
      "cross_repo": false,
      "re_derive": "EntityPipelineTraits over the extracted client jar's layer classes",
      "test_class": "lib.minecraft.renderer.pipeline.loader.OverlayPipelineRosterTest"
    },
    "roster.pack-fixtures": {
      "cross_repo": false,
      "re_derive": "PipelineParityDump's PACK_FIXTURES, also a provenance field on the two dump manifests",
      "test_class": "lib.minecraft.renderer.pipeline.dump.PipelineParityDump"
    },
    "roster.player-scopes": {
      "cross_repo": false,
      "lines": "100",
      "re_derive": "the scopes the harness PlayerSweep renders",
      "test_class": "lib.minecraft.renderer.visual.TestPlayerParityVanilla"
    },
    "roster.sheet-groups": {
      "cross_repo": false,
      "re_derive": "the -Psheets groups TestPlayerRender accepts; ten offline plus the network-only account group",
      "test_class": "lib.minecraft.renderer.visual.TestPlayerRender"
    }
  }
